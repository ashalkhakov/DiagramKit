# What DiagramKit builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux    the stack's archive, unpacked into /opt/gnustep
#   Windows  the stack's archive, unpacked into C:\GNUstep

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.20.36
